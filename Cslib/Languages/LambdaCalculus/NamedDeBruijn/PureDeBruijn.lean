public import Mathlib.Data.Finset.Image

/-! # Free indices, shifting and abstraction on de Bruijn terms

Free indices, size, shifting and substitution on Cslib's de Bruijn terms `Unscoped.Untyped.Term`,
and abstraction `dLAM i t` over a free index `i`, which builds de Bruijn terms the way named
terms are built. `dLAM` and the β-reduction `DBeta'` stated with it are from [Norrish2007a],
where the constructors are written `dV`, `dAPP`, `dABS`.

## Main definitions

* `Term.lift`, `Term.nsub`, `Term.dsub` : shifting, Nipkow's substitution and substitution
  without decrement, aliases of `Term.incre 1`, `Term.sub` and `Term.subst`.
* `Term.dLAM` : abstraction over the free index `i`.
* `DBeta'` : β-reduction stated with `dLAM` instead of `abs`.

## Main statements

* `Term.dABS_renamed` : every `abs` term is a `dLAM` term over any fresh index.

## References

* [Michael Norrish and René Vestergaard, *Proof Pearl: de Bruijn Terms Really Do
  Work*][Norrish2007a]
-/

@[expose] public section

namespace Cslib.LambdaCalculus.Unscoped.Untyped

attribute [blueprint "def:nv-db"
  (title := "de Bruijn terms")
  (statement := /-- The type $\mathsf{dB}$ of de Bruijn terms is the free algebra generated by
    \[ \mathsf{dB} \;\cong\; \mathbb{N} + \mathsf{dB} \times \mathsf{dB} + \mathsf{dB} \]
    with constructors $\mathsf{dV}$, $\mathsf{dAPP}$ and $\mathsf{dABS}$ for the three cases.
    ([Norrish2007a], equation (2).) -/)] Term

attribute [blueprint "def:nv-1"
  (title := "Definition 1: the relation $\\to_d$")
  (statement := /-- The relation $\to_d$ on de Bruijn terms is the least relation satisfying
    \begin{gather*}
      \frac{}{\mathsf{dAPP}\,(\mathsf{dABS}\,t)\,u \to_d \mathsf{nsub}\,u\,0\,t} \qquad
      \frac{t \to_d u}{\mathsf{dAPP}\,t\,z \to_d \mathsf{dAPP}\,u\,z} \\[1ex]
      \frac{t \to_d u}{\mathsf{dAPP}\,z\,t \to_d \mathsf{dAPP}\,z\,u} \qquad
      \frac{t \to_d u}{\mathsf{dABS}\,t \to_d \mathsf{dABS}\,u}
    \end{gather*}
    with $\mathsf{nsub}$ as in \cref{def:nv-nsub}.
    ([Norrish2007a], Definition 1, after Nipkow.) -/)] Beta

namespace Term

/-- `lift t k` adds one to every free index of `t` that is at least `k`, which makes room for a new
binder at depth `k`. This is Cslib's `Term.incre 1 k`. -/
@[blueprint "def:nv-lift"
  (title := "Figure 2: $\\mathsf{lift}$")
  (statement := /-- The function $\mathsf{lift}$ adds one to all free indices of a term that are at
    least
    the given bound:
    \begin{align*}
      \mathsf{lift}\,(\mathsf{dV}\,i)\,k &=
        \text{if } i < k \text{ then } \mathsf{dV}\,i \text{ else } \mathsf{dV}\,(i+1)\\
      \mathsf{lift}\,(\mathsf{dAPP}\,t\,u)\,k &=
        \mathsf{dAPP}\,(\mathsf{lift}\,t\,k)\,(\mathsf{lift}\,u\,k)\\
      \mathsf{lift}\,(\mathsf{dABS}\,t)\,k &= \mathsf{dABS}\,(\mathsf{lift}\,t\,(k+1))
    \end{align*}
    ([Norrish2007a], Figure 2, after Nipkow.) -/)]
abbrev lift (t : Term) (k : ℕ) : Term := incre 1 k t

/-- `lift` on `var`. -/
lemma lift_var (i k : ℕ) : lift (var i) k = if i < k then var i else var (i + 1) := by
  by_cases h : k ≤ i <;> simp [lift, incre, h]

/-- `lift` on `app`. -/
lemma lift_app (t u : Term) (k : ℕ) : lift (app t u) k = app (lift t k) (lift u k) :=
  rfl

/-- `lift` on `abs`. -/
lemma lift_abs (t : Term) (k : ℕ) : lift (abs t) k = abs (lift t (k + 1)) := rfl

/-- `nsub z k t` is Nipkow's substitution: it puts `z` in place of the index `k` and decrements
all larger free indices, as needed when a redex is contracted. An alias for `Term.sub`. -/
@[blueprint "def:nv-nsub"
  (title := "Figure 2: $\\mathsf{nsub}$")
  (statement := /-- Nipkow's substitution $\mathsf{nsub}$ substitutes for an index and at the same
    time
    decrements all larger free indices:
    \begin{align*}
      \mathsf{nsub}\,z\,k\,(\mathsf{dV}\,i) &=
        \text{if } k < i \text{ then } \mathsf{dV}\,(i-1)
        \text{ else if } i = k \text{ then } z \text{ else } \mathsf{dV}\,i\\
      \mathsf{nsub}\,z\,k\,(\mathsf{dAPP}\,t\,u) &=
        \mathsf{dAPP}\,(\mathsf{nsub}\,z\,k\,t)\,(\mathsf{nsub}\,z\,k\,u)\\
      \mathsf{nsub}\,z\,k\,(\mathsf{dABS}\,t) &=
        \mathsf{dABS}\,(\mathsf{nsub}\,(\mathsf{lift}\,z\,0)\,(k+1)\,t)
    \end{align*}
    ([Norrish2007a], Figure 2, after Nipkow.) -/)]
abbrev nsub (z : Term) (k : ℕ) (t : Term) : Term := t.sub k z

/-- `nsub` on `var`. -/
lemma nsub_var (z : Term) (k i : ℕ) :
    nsub z k (var i) = if k < i then var (i - 1) else if i = k then z else var i := by
  rcases lt_trichotomy i k with h | h | h
  · simp [nsub, var_lt_sub h, Nat.not_lt.mpr h.le, Nat.ne_of_lt h]
  · simp [nsub, h]
  · simp [nsub, var_gt_sub h, h]

/-- `nsub` on `app`. -/
lemma nsub_app (z : Term) (k : ℕ) (t u : Term) :
    nsub z k (app t u) = app (nsub z k t) (nsub z k u) := rfl

/-- `nsub` on `abs`. -/
lemma nsub_abs (z : Term) (k : ℕ) (t : Term) :
    nsub z k (abs t) = abs (nsub (lift z 0) (k + 1) t) := abs_sub_zero

/-- `dsub z k t` puts `z` in place of the index `k` in `t` and leaves the other free indices
alone. An alias for `Term.subst` (`sub` in [Norrish2007a]). -/
@[blueprint "def:nv-4"
  (title := "Definition 4: a clean notion of substitution for $\\mathsf{dB}$")
  (statement := /-- \begin{align*}
      \mathsf{sub}\,z\,k\,(\mathsf{dV}\,i) &=
        \text{if } i = k \text{ then } z \text{ else } \mathsf{dV}\,i\\
      \mathsf{sub}\,z\,k\,(\mathsf{dAPP}\,t\,u) &=
        \mathsf{dAPP}\,(\mathsf{sub}\,z\,k\,t)\,(\mathsf{sub}\,z\,k\,u)\\
      \mathsf{sub}\,z\,k\,(\mathsf{dABS}\,t) &=
        \mathsf{dABS}\,(\mathsf{sub}\,(\mathsf{lift}\,z\,0)\,(k+1)\,t)
    \end{align*}
    Unlike $\mathsf{nsub}$ (\cref{def:nv-nsub}), it does not decrement the other free indices.
    ([Norrish2007a], Definition 4.) -/)]
abbrev dsub (z : Term) (k : ℕ) (t : Term) : Term := subst k z t

/-- `dsub` on `var`. -/
lemma dsub_var (z : Term) (k i : ℕ) : dsub z k (var i) = if i = k then z else var i :=
  rfl

/-- `dsub` on `app`. -/
lemma dsub_app (z : Term) (k : ℕ) (t u : Term) :
    dsub z k (app t u) = app (dsub z k t) (dsub z k u) := rfl

/-- `dsub` on `abs`. -/
lemma dsub_abs (z : Term) (k : ℕ) (t : Term) :
    dsub z k (abs t) = abs (dsub (lift z 0) (k + 1) t) := rfl

/-- The set of free indices of a de Bruijn term. -/
@[blueprint "def:nv-dfv"
  (title := "Free indices")
  (statement := /-- The finite set $\mathsf{dFV}(t)$ of free indices of a de Bruijn term $t$ is
    defined by
    \[ \mathsf{dFV}(\mathsf{dV}\,i) = \{i\} \qquad
       \mathsf{dFV}(\mathsf{dAPP}\,t\,u) = \mathsf{dFV}(t) \cup \mathsf{dFV}(u) \qquad
       \mathsf{dFV}(\mathsf{dABS}\,t) = \{\, j \mid j + 1 \in \mathsf{dFV}(t) \,\} \]
    (Used in [Norrish2007a], Lemma 6 and Section 4.2.) -/)]
def dFV : Term → Finset ℕ
  | var i => {i}
  | app t u => dFV t ∪ dFV u
  | abs t => ((dFV t).erase 0).image (· - 1)

/-- The free index of `var i` is `i`. -/
lemma mem_dFV_var (i j : ℕ) : j ∈ dFV (var i) ↔ i = j := by
  simp [dFV, eq_comm]

/-- The free indices of an application. -/
lemma mem_dFV_app (t u : Term) (j : ℕ) : j ∈ dFV (app t u) ↔ j ∈ dFV t ∨ j ∈ dFV u := by
  simp [dFV]

/-- An index is free in `abs t` iff its successor is free in `t`. -/
lemma mem_dFV_abs (t : Term) (j : ℕ) : j ∈ dFV (abs t) ↔ j + 1 ∈ dFV t := by
  constructor
  · intro h
    simp only [dFV, Finset.mem_image, Finset.mem_erase] at h
    obtain ⟨k, ⟨hk0, hk⟩, rfl⟩ := h
    rwa [Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr hk0)]
  · intro h
    simp only [dFV, Finset.mem_image, Finset.mem_erase]
    exact ⟨j + 1, ⟨by omega, h⟩, by omega⟩

/-- The free indices of a lifted term. -/
lemma mem_dFV_lift (t : Term) (n j : ℕ) :
    j ∈ dFV (lift t n) ↔ (j < n ∧ j ∈ dFV t) ∨ (n < j ∧ j - 1 ∈ dFV t) := by
  induction t generalizing n j with
  | var i =>
      grind [lift_var, mem_dFV_var]
  | app t u iht ihu =>
      simp only [lift_app, mem_dFV_app, iht, ihu]
      tauto
  | abs t ih =>
      simp only [lift_abs, mem_dFV_abs, ih, Nat.add_sub_cancel]
      grind

/-- The free indices of a `dsub`-substitution. -/
lemma mem_dFV_dsub (z : Term) (k : ℕ) (t : Term) (j : ℕ) :
    j ∈ dFV (dsub z k t) ↔ (j ∈ dFV t ∧ j ≠ k) ∨ (k ∈ dFV t ∧ j ∈ dFV z) := by
  induction t generalizing z k j with
  | var i =>
      grind [dsub_var, mem_dFV_var]
  | app t u iht ihu =>
      simp only [dsub_app, mem_dFV_app, iht, ihu]
      tauto
  | abs t ih =>
      simp only [dsub_abs, mem_dFV_abs, ih, mem_dFV_lift]
      grind

/-- Substituting for an index that does not occur free changes nothing. -/
lemma dsub_of_not_mem_dFV {t : Term} {k : ℕ} (h : k ∉ dFV t) (z : Term) : dsub z k t = t := by
  induction t generalizing z k with
  | var m => grind [dsub_var, mem_dFV_var]
  | app t₁ t₂ ih₁ ih₂ =>
      simp only [mem_dFV_app, not_or] at h
      simp only [dsub_app, ih₁ h.1, ih₂ h.2]
  | abs t ih =>
      simp only [mem_dFV_abs] at h
      simp only [dsub_abs, ih h]

/-- The number of nodes of a de Bruijn term. Unlike `sizeOf`, it does not count the numerals in
`var` nodes, which `lift` and `dsub` change. -/
def dbsize : Term → ℕ
  | var _ => 1
  | app t u => dbsize t + dbsize u + 1
  | abs t => dbsize t + 1

/-- `dbsize` on `var`. -/
lemma dbsize_var (i : ℕ) : dbsize (var i) = 1 := rfl

/-- `dbsize` on `app`. -/
lemma dbsize_app (t u : Term) : dbsize (app t u) = dbsize t + dbsize u + 1 := rfl

/-- `dbsize` on `abs`. -/
lemma dbsize_abs (t : Term) : dbsize (abs t) = dbsize t + 1 := rfl

/-- Lifting preserves `dbsize`. -/
lemma dbsize_lift (t : Term) (n : ℕ) : dbsize (lift t n) = dbsize t := by
  induction t generalizing n with
  | var i => simp only [lift_var]; split_ifs <;> rfl
  | app t u iht ihu => simp [lift_app, dbsize_app, iht, ihu]
  | abs t ih => simp [lift_abs, dbsize_abs, ih]

/-- Substituting a variable preserves `dbsize`. -/
lemma dbsize_dsub_var (k j : ℕ) (t : Term) : dbsize (dsub (var k) j t) = dbsize t := by
  induction t generalizing k j with
  | var m => simp only [dsub_var]; split_ifs <;> rfl
  | app t u iht ihu => simp [dsub_app, dbsize_app, iht, ihu]
  | abs t ih => simp only [dsub_abs, dbsize_abs, lift_var]; split_ifs <;> simp [ih]

/-- Definition 5 [Norrish2007a]: `dLAM i t` binds the free index `i` of `t`. It lifts `t`
past the new binder, so that `i` becomes `i + 1`, and then points that index at the binder by
substituting `var 0` for it. Like `LAM` on `Λα`, it is not injective. -/
@[blueprint "def:nv-5"
  (title := "Definition 5: abstraction over an index")
  (statement := /-- \[ \mathsf{dLAM}\,i\,t =
       \mathsf{dABS}\,(\mathsf{sub}\,(\mathsf{dV}\,0)\,(i+1)\,(\mathsf{lift}\,t\,0)) \]
    with $\mathsf{sub}$ as in \cref{def:nv-4} and $\mathsf{lift}$ as in \cref{def:nv-lift}.
    Like $\mathsf{LAM}$ on $\Lambda_\alpha$, the function $\mathsf{dLAM}$ is not injective.
    ([Norrish2007a], Definition 5.) -/)]
def dLAM (i : ℕ) (t : Term) : Term := abs (dsub (var 0) (i + 1) (lift t 0))

/-- The induction behind `dABS_renamed`: if `i` is not free in `t`, then `t` is a substitution of
`var n` for `i` in a lifted term. -/
@[blueprint "lem:nv-6-aux"
  (latexEnv := "lemma")
  (title := "Lemma 6, main induction")
  (statement := /-- If $i \notin \mathsf{dFV}(t)$ then for every $n$ there is a $t_0$ with
    $t = \mathsf{sub}\,(\mathsf{dV}\,n)\,i\,(\mathsf{lift}\,t_0\,n)$.
    ([Norrish2007a], proof of Lemma 6.) -/)
  (proof := /-- By structural induction on $t$. -/)]
lemma onto_lemma (t : Term) (i n : ℕ) (h : i ∉ dFV t) :
    ∃ t₀, t = dsub (var n) i (lift t₀ n) := by
  induction t generalizing i n with
  | var m =>
      simp only [mem_dFV_var] at h
      rcases eq_or_ne m n with rfl | hmn
      · rcases lt_or_ge i m with hi | hi
        · exact ⟨var i, by grind [lift_var, dsub_var]⟩
        · exact ⟨var (i - 1), by grind [lift_var, dsub_var]⟩
      · rcases lt_or_ge m n with hm | hm
        · exact ⟨var m, by grind [lift_var, dsub_var]⟩
        · exact ⟨var (m - 1), by grind [lift_var, dsub_var]⟩
  | app t u iht ihu =>
      simp only [mem_dFV_app, not_or] at h
      obtain ⟨t₀, ht⟩ := iht i n h.1
      obtain ⟨u₀, hu⟩ := ihu i n h.2
      exact ⟨app t₀ u₀, by rw [lift_app, dsub_app, ← ht, ← hu]⟩
  | abs t ih =>
      simp only [mem_dFV_abs] at h
      obtain ⟨t₀, ht⟩ := ih (i + 1) (n + 1) h
      refine ⟨abs t₀, ?_⟩
      rw [lift_abs, dsub_abs, lift_var, ite_eq_right (Nat.not_lt_zero _), ht]

/-- The free indices of a term are bounded. -/
lemma dFV_bounded (t : Term) : ∃ j, ∀ i ∈ dFV t, i < j := by
  induction t with
  | var i => exact ⟨i + 1, by grind [mem_dFV_var]⟩
  | app t u iht ihu =>
      obtain ⟨j₁, h₁⟩ := iht
      obtain ⟨j₂, h₂⟩ := ihu
      refine ⟨max j₁ j₂, fun k hk => ?_⟩
      simp only [mem_dFV_app] at hk
      grind
  | abs t ih =>
      obtain ⟨j, hj⟩ := ih
      refine ⟨j, fun k hk => ?_⟩
      grind [mem_dFV_abs]

/-- Every de Bruijn term has a fresh index. -/
lemma dfresh_exists (t : Term) : ∃ i, i ∉ dFV t := by
  obtain ⟨j, hj⟩ := dFV_bounded t
  exact ⟨j, fun h => lt_irrefl j (hj j h)⟩

/-- Lemma 6 [Norrish2007a]: if `i` is not free in `abs t`, then `abs t = dLAM i t₀` for some
`t₀`. -/
@[blueprint "lem:nv-6"
  (latexEnv := "lemma")
  (title := "Lemma 6: $\\mathsf{dABS}$ terms as $\\mathsf{dLAM}$ terms")
  (statement := /-- If $i$ is not among the free indices of $\mathsf{dABS}\,t$, then there is a
    $t_0$ such
    that $\mathsf{dABS}\,t = \mathsf{dLAM}\,i\,t_0$.
    ([Norrish2007a], Lemma 6.) -/)
  (proof := /-- From \cref{lem:nv-6-aux} with $n = 0$ and the index $i + 1$. -/)]
lemma dABS_renamed {t : Term} {i : ℕ} (h : i ∉ dFV (abs t)) : ∃ t₀, abs t = dLAM i t₀ := by
  obtain ⟨t₀, ht⟩ := onto_lemma t (i + 1) 0 (by simpa [mem_dFV_abs] using h)
  exact ⟨t₀, by rw [dLAM, ← ht]⟩

/-- The free indices of a `dLAM`-abstraction. -/
@[blueprint "lem:nv-dfv-dlam"
  (latexEnv := "lemma")
  (title := "Free indices of $\\mathsf{dLAM}$")
  (statement := /-- $\mathsf{dFV}(\mathsf{dLAM}\,i\,t) = \mathsf{dFV}(t) \setminus \{i\}$.
    ([Norrish2007a], proof of Theorem 11, stated there as
    $\mathrm{supp}(\mathsf{dLAM}\,i\,t) = \mathrm{supp}(t) \setminus \{\hat{\imath}\}$.) -/)
  (proof := /-- By computing the free indices of $\mathsf{lift}\,t\,0$ and of a
    $\mathsf{sub}$-substitution. -/)]
lemma dFV_dLAM (i : ℕ) (t : Term) : dFV (dLAM i t) = (dFV t).erase i := by
  ext j
  simp only [dLAM, mem_dFV_abs, mem_dFV_dsub, mem_dFV_lift, mem_dFV_var, Finset.mem_erase]
  grind

/-- Lifting commutes with substitution (the de Bruijn bookkeeping behind `dsub_dLAM`). -/
lemma lift_dsub (z : Term) (n j : ℕ) (t : Term) :
    lift (dsub z j t) n = dsub (lift z n) (if j < n then j else j + 1) (lift t n) := by
  induction t generalizing z n j with
  | var m => grind [lift_var, dsub_var]
  | app t u iht ihu => simp [lift_app, dsub_app, iht, ihu]
  | abs t ih =>
      have hidx : (if j + 1 < n + 1 then j + 1 else j + 1 + 1)
          = (if j < n then j else j + 1) + 1 := by split_ifs <;> omega
      simp only [dsub_abs, lift_abs, ih, incre_comm_zero, hidx]

/-- Two `dsub` substitutions for distinct indices commute, provided neither substituted term
contains the other's index free. -/
lemma dsub_dsub_comm {a b : Term} {k l : ℕ} (hkl : k ≠ l) (hb : k ∉ dFV b) (ha : l ∉ dFV a)
    (u : Term) : dsub a k (dsub b l u) = dsub b l (dsub a k u) := by
  induction u generalizing a b k l with
  | var m =>
      simp only [dsub_var]
      rcases eq_or_ne m l with rfl | hml
      · simp only [ite_true, hkl.symm, ite_false, dsub_var, dsub_of_not_mem_dFV hb]
      · rcases eq_or_ne m k with rfl | hmk
        · simp only [hml, ite_false, ite_true, dsub_var, dsub_of_not_mem_dFV ha]
        · simp only [hml, hmk, ite_false, dsub_var]
  | app u₁ u₂ ih₁ ih₂ => simp only [dsub_app, ih₁ hkl hb ha, ih₂ hkl hb ha]
  | abs u ih =>
      simp only [dsub_abs, ih (a := lift a 0) (b := lift b 0) (by omega : k + 1 ≠ l + 1)
        (by grind [mem_dFV_lift]) (by grind [mem_dFV_lift])]

/-- `dLAM` adds one node. -/
lemma dbsize_dLAM (i : ℕ) (t : Term) : dbsize (dLAM i t) = dbsize t + 1 := by
  simp [dLAM, dbsize_abs, dbsize_lift, dbsize_dsub_var]

/-- Substitution interacts with `dLAM` as it does with `LAM` in `Λα`. -/
@[blueprint "lem:nv-sub-dlam"
  (latexEnv := "lemma")
  (title := "Substitution under $\\mathsf{dLAM}$")
  (statement := /-- If $i \neq j$ and $i \notin \mathsf{dFV}(z)$ then
    $\mathsf{sub}\,z\,j\,(\mathsf{dLAM}\,i\,t) = \mathsf{dLAM}\,i\,(\mathsf{sub}\,z\,j\,t)$.
    (Not numbered in [Norrish2007a]; it is \texttt{sub\_dLAM} in the HOL4 sources.) -/)
  (proof := /-- Two substitutions for distinct indices commute when neither substituted term
    contains the other index free, and $\mathsf{lift}$ commutes with $\mathsf{sub}$. -/)]
lemma dsub_dLAM {z : Term} {i j : ℕ} {t : Term} (hij : i ≠ j) (hi : i ∉ dFV z) :
    dsub z j (dLAM i t) = dLAM i (dsub z j t) := by
  simp only [dLAM, dsub_abs]
  rw [dsub_dsub_comm (a := lift z 0) (b := var 0) (k := j + 1) (l := i + 1)
      (by omega) (by simp [mem_dFV_var]) (by grind [mem_dFV_lift]), lift_dsub]
  simp only [Nat.not_lt_zero, ite_false]

end Term

open Term in
/-- Definition 7 [Norrish2007a]: β-reduction `→d'` on de Bruijn terms, stated like β on `Λα`
with `dLAM` in place of `LAM`. -/
@[blueprint "def:nv-7"
  (title := "Definition 7: $\\mathsf{dB}'$ $\\beta$-reduction")
  (statement := /-- The relation $\to_{d'}$ on de Bruijn terms is the least relation satisfying
    \begin{gather*}
      \frac{}{\mathsf{dAPP}\,(\mathsf{dLAM}\,i\,t)\,u \to_{d'} \mathsf{sub}\,u\,i\,t} \qquad
      \frac{t \to_{d'} u}{\mathsf{dAPP}\,t\,z \to_{d'} \mathsf{dAPP}\,u\,z} \\[1ex]
      \frac{t \to_{d'} u}{\mathsf{dAPP}\,z\,t \to_{d'} \mathsf{dAPP}\,z\,u} \qquad
      \frac{t \to_{d'} u}{\mathsf{dLAM}\,i\,t \to_{d'} \mathsf{dLAM}\,i\,u}
    \end{gather*}
    ([Norrish2007a], Definition 7.) -/)]
inductive DBeta' : Term → Term → Prop where
  /-- Contraction: `app (dLAM i t) u →d' dsub u i t`. -/
  | red (i : ℕ) (t u : Term) : DBeta' (app (dLAM i t) u) (dsub u i t)
  /-- Congruence in the left argument of an application. -/
  | appL {t u : Term} (z : Term) : DBeta' t u → DBeta' (app t z) (app u z)
  /-- Congruence in the right argument of an application. -/
  | appR {t u : Term} (z : Term) : DBeta' t u → DBeta' (app z t) (app z u)
  /-- Congruence under a `dLAM`-abstraction. -/
  | lam {t u : Term} (i : ℕ) : DBeta' t u → DBeta' (dLAM i t) (dLAM i u)

@[inherit_doc] scoped infix:39 " →d' " => DBeta'

end Cslib.LambdaCalculus.Unscoped.Untyped
